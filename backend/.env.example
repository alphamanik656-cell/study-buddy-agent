PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# AI_PROVIDER: "ollama" for free local dev, "groq" for the live/hosted deploy (free API,
# a deployed backend can't reach your local Ollama instance), or "anthropic" (paid, optional).
AI_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# Only needed when AI_PROVIDER=groq (free — get a key at console.groq.com)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Only needed when AI_PROVIDER=anthropic (paid, optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
